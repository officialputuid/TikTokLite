{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Lite",
  "identifier": "com.officialputuid.tiktoklite",
  "build": {
    "frontendDist": "assets"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
